generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  phone              String         @unique
  email              String?        @unique
  password           String
  realName           String
  avatar             String?
  role               UserRole
  isActive           Boolean        @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  mustChangePassword Boolean        @default(false)
  createdCourses     Course[]       @relation("CreatedBy")
  createdEnrollments Enrollment[]   @relation("CreatedBy")
  operatedAcademicEvents StudentAcademicEvent[] @relation("AcademicEventOperator")
  operationLogs      OperationLog[]
  createdStudents    Student[]      @relation("CreatedBy")
  studentProfile     Student?
  teacherProfile     Teacher?

  @@map("users")
}

model Student {
  id                 String       @id @default(uuid())
  studentCode        String       @unique
  name               String
  gender             Gender
  age                Int
  birthDate          DateTime
  birthday           DateTime
  idNumber           String       @unique
  idCardAddress      String
  contactPhone       String
  photo              String?
  idCardFront        String?
  idCardBack         String?
  currentAddress     String
  emergencyContact   String
  emergencyPhone     String
  emergencyRelation  String
  healthStatus       String?
  medicalHistory     String?
  allergies          String?
  interests          String[]     @default([])
  tags               String[]     @default([])
  remarks            String?
  isActive           Boolean      @default(true)
  ethnicity          String?
  educationLevel     String?
  politicalStatus    String?
  phone              String?
  isRetired          Boolean      @default(false)
  retirementCategory String?
  familyAddress      String?
  familyPhone        String?
  major              String?
  semester           String?
  selectedCourses    String[]     @default([])
  studyPeriodStart   DateTime?
  studyPeriodEnd     DateTime?
  studentId          String?
  agreementSigned    Boolean      @default(false)
  applicationDate    DateTime?
  status             String?
  currentGrade       String?
  enrollmentYear     Int?
  enrollmentSemester String?
  graduationStatus   String       @default("IN_PROGRESS")
  graduationDate     DateTime?
  academicStatus     String       @default("ACTIVE")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String?      @unique
  createdBy          String
  insuranceCompany   String?
  attendances        Attendance[]
  enrollments        Enrollment[]
  enrollmentApplications EnrollmentApplication[]
  rosterMembers      RosterMember[]
  studentInsurances  StudentInsurance[]
  academicEvents     StudentAcademicEvent[]
  creator            User         @relation("CreatedBy", fields: [createdBy], references: [id])
  user               User?        @relation(fields: [userId], references: [id])

  @@index([name, idNumber, contactPhone])
  @@index([graduationStatus, academicStatus])
  @@index([currentGrade, enrollmentYear])
  @@map("students")
}

model Teacher {
  id           String          @id @default(uuid())
  teacherCode  String          @unique
  realName     String
  gender       Gender
  phone        String          @unique
  email        String?         @unique
  specialties  String[]        @default([])
  experience   Int
  level        String?
  certificates String[]        @default([])
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  userId       String          @unique
  courses      CourseTeacher[]
  user         User            @relation(fields: [userId], references: [id])

  @@map("teachers")
}

model Course {
  id                String          @id @default(uuid())
  courseCode        String?         @unique
  name              String
  description       String?
  category          String
  level             String
  duration          Int
  maxStudents       Int
  price             Decimal?        @db.Decimal(10, 2)
  hasAgeRestriction Boolean         @default(false)
  minAge            Int?
  maxAge            Int?
  ageDescription    String?
  tags              String[]        @default([])
  keywords          String[]        @default([])
  timeSlots         Json
  status            CourseStatus    @default(DRAFT)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String
  credits           Int?
  endDate           DateTime?
  startDate         DateTime?
  location          String?
  semester          String?
  teacher           String?
  gradeDescription  String?
  requiresGrades    Boolean         @default(true)
  attendances       Attendance[]
  teachers          CourseTeacher[]
  creator           User            @relation("CreatedBy", fields: [createdBy], references: [id])
  enrollments       Enrollment[]
  classSections     ClassSection[]

  @@index([name, category, level])
  @@map("courses")
}

model CourseTeacher {
  id        String   @id @default(uuid())
  courseId  String
  teacherId String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([courseId, teacherId])
  @@map("course_teachers")
}

model Enrollment {
  id               String           @id @default(uuid())
  enrollmentCode   String           @unique
  studentId        String
  courseId         String
  status           EnrollmentStatus @default(PENDING)
  enrollmentDate   DateTime         @default(now())
  approvedAt       DateTime?
  approvedBy       String?
  cancelledAt      DateTime?
  cancelReason     String?
  remarks          String?
  paymentStatus    PaymentStatus    @default(UNPAID)
  paymentAmount    Decimal?         @db.Decimal(10, 2)
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String
  insuranceEnd     DateTime?
  insuranceStart   DateTime?
  course           Course           @relation(fields: [courseId], references: [id])
  creator          User             @relation("CreatedBy", fields: [createdBy], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])
  rosterMembers    RosterMember[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  courseId       String
  attendanceDate DateTime
  status         AttendanceStatus @default(ABSENT)
  method         AttendanceMethod @default(MANUAL)
  checkInTime    DateTime?
  isLate         Boolean          @default(false)
  lateMinutes    Int?
  faceImageUrl   String?
  faceScore      Float?
  locationData   Json?
  deviceInfo     Json?
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  course         Course           @relation(fields: [courseId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@index([attendanceDate, status])
  @@index([studentId, courseId])
  @@map("attendances")
}

model OperationLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  resource      String
  resourceId    String?
  details       Json?
  ip            String?
  userAgent     String?
  requestUrl    String?
  requestMethod String?
  success       Boolean  @default(true)
  error         String?
  duration      Int?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, resource])
  @@map("operation_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  dataType    String   @default("string")
  isSystem    Boolean  @default(false)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

model FileUpload {
  id           String    @id @default(uuid())
  originalName String
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  fileType     String
  metadata     Json?
  uploadedBy   String?
  isTemp       Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  insuranceAttachments StudentInsurance[] @relation("InsuranceAttachment")

  @@index([uploadedBy, createdAt])
  @@index([isTemp, expiresAt])
  @@map("file_uploads")
}

model AcademicYear {
  id                     String                  @id @default(uuid())
  code                   String                  @unique
  name                   String
  startsAt               DateTime
  endsAt                 DateTime
  enrollmentStartsAt     DateTime?
  enrollmentEndsAt       DateTime?
  requiredInsuranceStart DateTime
  requiredInsuranceEnd   DateTime
  isActive               Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  semesters              Semester[]
  classSections          ClassSection[]
  rosters                Roster[]
  enrollmentApplications EnrollmentApplication[]
  studentInsurances      StudentInsurance[]

  @@map("academic_years")
}

model Semester {
  id                     String                  @id @default(uuid())
  academicYearId         String
  code                   String                  @unique
  name                   String
  startsAt               DateTime?
  endsAt                 DateTime?
  isEnrollmentOpen       Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id])
  classSections          ClassSection[]
  rosters                Roster[]
  enrollmentApplications EnrollmentApplication[]

  @@index([academicYearId])
  @@map("semesters")
}

model ClassSection {
  id                String                        @id @default(uuid())
  code              String                        @unique
  name              String
  academicYearId    String
  semesterId        String
  courseId          String
  grade             String?
  major             String
  capacity          Int
  timeSlots         Json
  status            String                        @default("DRAFT")
  isActive          Boolean                       @default(true)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  academicYear      AcademicYear                  @relation(fields: [academicYearId], references: [id])
  semester          Semester                      @relation(fields: [semesterId], references: [id])
  course            Course                        @relation(fields: [courseId], references: [id])
  rosters           Roster[]
  rosterMembers     RosterMember[]
  enrollmentChoices EnrollmentApplicationChoice[]

  @@index([academicYearId, semesterId])
  @@index([courseId])
  @@map("class_sections")
}

model Roster {
  id             String         @id @default(uuid())
  code           String         @unique
  classSectionId String
  semesterId     String
  academicYearId String
  status         RosterStatus   @default(DRAFT)
  snapshotAt     DateTime       @default(now())
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id])
  semester       Semester       @relation(fields: [semesterId], references: [id])
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  members        RosterMember[]

  @@unique([classSectionId, semesterId])
  @@index([semesterId])
  @@map("rosters")
}

model RosterMember {
  id                 String             @id @default(uuid())
  rosterId           String
  classSectionId     String
  studentId          String
  sourceEnrollmentId String?
  status             RosterMemberStatus @default(ACTIVE)
  joinedAt           DateTime           @default(now())
  leftAt             DateTime?
  remarks            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  roster             Roster             @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  classSection       ClassSection       @relation(fields: [classSectionId], references: [id])
  student            Student            @relation(fields: [studentId], references: [id])
  sourceEnrollment   Enrollment?        @relation(fields: [sourceEnrollmentId], references: [id])

  @@unique([rosterId, studentId])
  @@index([classSectionId, status])
  @@index([studentId])
  @@map("roster_members")
}

model EnrollmentApplication {
  id             String                      @id @default(uuid())
  applicationCode String                     @unique
  studentId       String
  academicYearId  String
  semesterId      String
  insuranceId     String?
  status          EnrollmentApplicationStatus @default(SUBMITTED)
  source          String                       @default("SELF_SERVICE")
  submittedAt     DateTime                     @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  remarks         String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  student         Student                      @relation(fields: [studentId], references: [id])
  academicYear    AcademicYear                 @relation(fields: [academicYearId], references: [id])
  semester        Semester                     @relation(fields: [semesterId], references: [id])
  insurance       StudentInsurance?            @relation(fields: [insuranceId], references: [id])
  choices         EnrollmentApplicationChoice[]

  @@index([studentId, academicYearId])
  @@index([semesterId, status])
  @@map("enrollment_applications")
}

model EnrollmentApplicationChoice {
  id             String                 @id @default(uuid())
  applicationId  String
  choiceOrder    Int
  classSectionId String
  status         EnrollmentChoiceStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  application    EnrollmentApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  classSection   ClassSection           @relation(fields: [classSectionId], references: [id])

  @@unique([applicationId, choiceOrder])
  @@unique([applicationId, classSectionId])
  @@index([classSectionId, status])
  @@map("enrollment_application_choices")
}

model StudentInsurance {
  id             String                @id @default(uuid())
  studentId      String
  academicYearId String
  company        String
  category       String?
  coverageStart  DateTime
  coverageEnd    DateTime
  attachmentFileId String?
  reviewStatus   InsuranceReviewStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  student        Student               @relation(fields: [studentId], references: [id])
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id])
  attachment     FileUpload?           @relation("InsuranceAttachment", fields: [attachmentFileId], references: [id])
  applications   EnrollmentApplication[]

  @@index([studentId, academicYearId])
  @@index([academicYearId, reviewStatus])
  @@map("student_insurances")
}

model StudentAcademicEvent {
  id         String   @id @default(uuid())
  studentId  String
  eventType  String
  fromValue  String?
  toValue    String?
  reason     String?
  operatorId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id])
  operator   User?    @relation("AcademicEventOperator", fields: [operatorId], references: [id])

  @@index([studentId, createdAt])
  @@index([eventType, createdAt])
  @@map("student_academic_events")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum AttendanceMethod {
  FACE_RECOGNITION
  MANUAL
  QR_CODE
  CARD
}

enum RosterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RosterMemberStatus {
  ACTIVE
  DROPPED
  TRANSFERRED
  GRADUATED
}

enum EnrollmentApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum EnrollmentChoiceStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum InsuranceReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
